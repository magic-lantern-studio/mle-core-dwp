# Tokens of the Digital Workprint format, for libFuzzer (-dict=fuzz/dwp.dict).
magic="#DWP 1.0 ascii\n"
open="( "
close=" )"
quote="\""
escape="\\"
comment="# "
kw_actor="Actor"
kw_actordef="ActorDef"
kw_actortemplate="ActorTemplate"
kw_group="Group"
kw_scene="Scene"
kw_stage="Stage"
kw_set="Set"
kw_setdef="SetDef"
kw_rolebinding="RoleBinding"
kw_rolesetmapping="RoleSetMapping"
kw_roledef="RoleDef"
kw_roleattachment="RoleAttachment"
kw_property="Property"
kw_propertydef="PropertyDef"
kw_package="Package"
kw_media="Media"
kw_mediaref="MediaRef"
kw_converter="Converter"
kw_filetype="Filetype"
kw_limits="Limits"
kw_container="Container"
kw_headerfile="HeaderFile"
kw_sourcefile="SourceFile"
kw_unknown="Bogus"
type_vec2="MlVector2"
type_vec3="MlVector3"
type_vec4="MlVector4"
type_rot="MlRotation"
type_xform="MlTransform"
type_string="string"
type_int="int"
type_float="float"
type_floatarray="FloatArray"
type_intarray="IntArray"
type_enum="enum"
tag_rehearsal="+rehearsal"
tag_runtime="+runtime"
array_open="["
array_close="]"
sep=","
num_big="1e999"
num_neg="-1"
num_nan="nan"
